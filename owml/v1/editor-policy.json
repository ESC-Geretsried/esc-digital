{
  "owml_version": "1.0.0",
  "policy": "normal editors may edit content only; structural changes require architecture review",
  "normal_editor_mutable_slots": [
    "title", "summary", "body", "hero-media", "team-photo", "roster", "news",
    "schedule-editorial", "contacts", "events", "people", "sponsor-records", "downloads"
  ],
  "architecture_only_fields": [
    "owml", "owml_version", "pattern", "pattern_id", "nodes", "sections",
    "node_order", "node_type", "route", "navigation", "anchors", "renderer",
    "component", "layout", "data_binding"
  ],
  "structure_lock": true,
  "change_workflow": "Founder/architecture decision -> OWML Git change -> validation -> implementation -> tests -> review"
}
